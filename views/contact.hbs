

<main>

<section>

<h2>Contact Us</h2>

<p>
Have a question about our products? Fill out the form below and we will contact you as soon as possible.
</p>

<form action="https://formsubmit.co/babakkonon92@gmail.com" method="POST">

<input type="hidden" name="_subject" value="New message from SickoWear Website">

<input type="hidden" name="_captcha" value="false">

<input type="hidden" name="_template" value="table">

<input type="hidden" name="_next" value="thankyou.html">

<label for="name">Full Name</label>

<input
type="text"
id="name"
name="Name"
autocomplete="name"
placeholder="Enter your full name"
required
minlength="2">

<label for="email">Email Address</label>

<input
type="email"
id="email"
name="Email"
autocomplete="email"
placeholder="Enter your email"
required>

<label for="phone">Phone Number</label>

<input
type="tel"
id="phone"
name="Phone"
autocomplete="tel"
placeholder="0871234567"
pattern="(?:\+353|0)[0-9 ]{9,12}"
title="Enter an Irish phone number beginning with 0 or +353"
required>

<label for="message">Message</label>

<textarea
id="message"
name="Message"
rows="6"
placeholder="Write your message..."
minlength="10"
maxlength="1000"
required></textarea>

<input type="submit" value="Send Message">

</form>

</section>

